#: src/Application.vala:50
msgid "Show version"
msgstr "Ցուցադրել տարբերակը"

#. -n flag forces a new window
#: src/Application.vala:52
msgid "Open a new terminal window"
msgstr "Բացել տերմինալի նոր պատուհան"

#. -t flag forces a new tab
#: src/Application.vala:54
msgid "Open a new terminal tab at current working directory"
msgstr "Բացել տերմինալի նոր ներդիր ընթացիկ աշխատանքային պանակում"

#. -w flag defines the working directory that the new tab/window uses
#: src/Application.vala:56
msgid "Set shell working directory"
msgstr "Սահմանել թաղանթի աշխատանքային պանակը"

#. -e flag is used for running single strings as a command line
#: src/Application.vala:58
msgid "Run a program in terminal"
msgstr "Գործարկել ծրագիր տերմինալում"

#. -m flag starts terminal in a minimized state
#: src/Application.vala:60
msgid "Open terminal in a minimized state"
msgstr "Բացել տերմինալը ծալված վիճակում"

#. -x flag is used for using the rest of the command line in the new tab/window
#: src/Application.vala:63
msgid "Run remainder of line as a command in terminal"
msgstr "Տողի մնացած մասը գործարկել որպես հրաման տերմինալում"

#: src/Application.vala:115
msgid "[-- COMMAND…]"
msgstr "[-- ՀՐԱՄԱՆ…]"

#: src/Application.vala:180
msgid "Terminal needs your attention"
msgstr "Տերմինալը Ձեր ուշադրության կարիքն ունի"

#: src/Application.vala:232
msgid "Process completed"
msgstr "Պրոցեսն ավարտվել է"

#: src/Application.vala:235
msgid "Process exited with errors"
msgstr "Պրոցեսն ավարտվել է սխալներով"

#: src/MainWindow.vala:187
msgid "Exit FullScreen"
msgstr "Դուրս գալ ամբողջ էկրանի ռեժիմից"

#: src/MainWindow.vala:196 src/MainWindow.vala:643
msgid "Find…"
msgstr "Գտնել…"

#: src/MainWindow.vala:202
msgid "New Tab…"
msgstr "Նոր ներդիր…"

#: src/MainWindow.vala:214
msgid "Settings"
msgstr "Կարգավորումներ"

#: src/MainWindow.vala:259
msgid "Are you sure you want to close this tab?"
msgstr "Դուք համոզվա՞ծ եք, որ ցանկանում եք փակել այս ներդիրը։"

#: src/MainWindow.vala:260
msgid "Close tab"
msgstr "Փակել ներդիրը"

#: src/MainWindow.vala:502
msgid ""
"Are you sure you want to close all foreground processes before closing the "
"window?"
msgstr ""
"Դուք համոզվա՞ծ եք, որ ցանկանում եք փակել առաջին պլանի բոլոր պրոցեսները "
"նախքան պատուհանը փակելը։"

#: src/MainWindow.vala:503
msgid "Close window"
msgstr "Փակել պատուհանը"

#: src/MainWindow.vala:633
msgid "Hide find bar"
msgstr "Թաքցնել որոնման գոտին"

#: src/Utils.vala:142
msgid "The pasted text may contain multiple commands"
msgstr "Տեղադրվող տեքստը կարող է պարունակել մի քանի հրաման"

#: src/Utils.vala:146
msgid "The pasted text may be trying to gain administrative access"
msgstr "Տեղադրվող տեքստը կարող է փորձել ադմինիստրատորի հասանելիություն ստանալ"

#: src/Utils.vala:161
msgid "The pasted text includes a command to skip warnings and confirmations"
msgstr ""
"Տեղադրվող տեքստը պարունակում է նախազգուշացումներն ու հաստատումները շրջանցող "
"հրաման"

