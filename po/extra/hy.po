#: data/terminal.metainfo.xml.in:10 data/io.elementary.terminal.desktop.in:2
#: data/io.elementary.terminal.desktop.in:3
msgid "Terminal"
msgstr "Տերմինալ"

#: data/terminal.metainfo.xml.in:11 data/io.elementary.terminal.desktop.in:4
msgid "Use the command line"
msgstr "Օգտագործեք հրամանային տողը"

#: data/terminal.metainfo.xml.in:13
msgid ""
"Terminal is a terminal emulator application for accessing a UNIX shell "
"environment which can be used to run programs available on your system."
msgstr ""
"Տերմինալը տերմինալի էմուլյատոր է, որը հնարավորություն է տալիս մուտք գործել "
"UNIX թաղանթի միջավայր և գործարկել համակարգում հասանելի ծրագրերը։"

#: data/terminal.metainfo.xml.in:51
msgid "elementary, Inc."
msgstr "elementary, Inc."

#: data/terminal.metainfo.xml.in:59 data/terminal.metainfo.xml.in:77
#: data/terminal.metainfo.xml.in:148
msgid "New features:"
msgstr "Նոր հնարավորություններ՝"

#: data/terminal.metainfo.xml.in:61
msgid ""
"Pressing Alt + 0 or holding Alt down now shows the tab number in the tab "
"labels"
msgstr ""
"Alt + 0 սեղմելիս կամ Alt-ը սեղմած պահելիս ներդիրների պիտակներում այժմ "
"ցուցադրվում է ներդիրի համարը"

#: data/terminal.metainfo.xml.in:62
msgid "Foreground processes can now request attention using a DBus method"
msgstr ""
"Առաջին պլանի պրոցեսներն այժմ կարող են ուշադրություն պահանջել DBus մեթոդի "
"միջոցով"

#: data/terminal.metainfo.xml.in:64 data/terminal.metainfo.xml.in:82
#: data/terminal.metainfo.xml.in:107 data/terminal.metainfo.xml.in:122
#: data/terminal.metainfo.xml.in:134 data/terminal.metainfo.xml.in:153
#: data/terminal.metainfo.xml.in:171 data/terminal.metainfo.xml.in:184
msgid "Other updates:"
msgstr "Այլ թարմացումներ՝"

#: data/terminal.metainfo.xml.in:66 data/terminal.metainfo.xml.in:88
#: data/terminal.metainfo.xml.in:110 data/terminal.metainfo.xml.in:124
#: data/terminal.metainfo.xml.in:136 data/terminal.metainfo.xml.in:156
#: data/terminal.metainfo.xml.in:173 data/terminal.metainfo.xml.in:188
msgid "Translation updates"
msgstr "Թարմացված թարգմանություններ"

#: data/terminal.metainfo.xml.in:79
msgid "Ctrl + BackSpace can now be used delete words"
msgstr "Այժմ Ctrl + BackSpace-ով կարելի է ջնջել բառերը"

#: data/terminal.metainfo.xml.in:80
msgid "Ctrl + Click is now required to open a link"
msgstr "Հղում բացելու համար այժմ պահանջվում է Ctrl + սեղմում"

#: data/terminal.metainfo.xml.in:84
msgid "Update code and packaging for Gtk4"
msgstr "Կոդն ու փաթեթավորումը թարմացվել են Gtk4-ի համար"

#: data/terminal.metainfo.xml.in:85
msgid "Flatter styles"
msgstr "Ավելի հարթ ոճեր"

#: data/terminal.metainfo.xml.in:86
msgid "Tab bar now in window drag area"
msgstr "Ներդիրների գոտին այժմ պատուհանը քաշելու տիրույթում է"

#: data/terminal.metainfo.xml.in:87
msgid "Smart copy no longer deselects"
msgstr "Խելացի պատճենումն այլևս չի չեղարկում ընտրությունը"

#: data/terminal.metainfo.xml.in:109
msgid ""
"The option to hide the tabbar when there is only one tab is now exposed and "
"honored"
msgstr ""
"Մեկ ներդիրի դեպքում ներդիրների գոտին թաքցնելու ընտրանքն այժմ հասանելի է և "
"գործում է"

#: data/terminal.metainfo.xml.in:150
msgid ""
"A warning is now given if a pasted command has an option that skips "
"confirmations"
msgstr ""
"Այժմ նախազգուշացում է տրվում, եթե տեղադրվող հրամանն ունի հաստատումները "
"շրջանցող ընտրանք"

#: data/terminal.metainfo.xml.in:151
msgid ""
"When a foreground process is launched, the tab label changes to the name of "
"that process"
msgstr ""
"Առաջին պլանի պրոցես գործարկելիս ներդիրի պիտակը փոխվում է այդ պրոցեսի անունով"

#: data/terminal.metainfo.xml.in:155
msgid "Exiting the shell in a tab now closes that tab"
msgstr "Ներդիրում թաղանթից դուրս գալն այժմ փակում է այդ ներդիրը"

#: data/terminal.metainfo.xml.in:186
msgid "Stop window size increasing when opened"
msgstr "Շտկվել է բացելիս պատուհանի չափի մեծացումը"

#: data/terminal.metainfo.xml.in:187
msgid "Change hotkeys for Reset and Clear Screen actions"
msgstr ""
"Փոխվել են «Վերակայել» և «Մաքրել էկրանը» գործողությունների դյուրանցումները"

#: data/io.elementary.terminal.desktop.in:12
msgid "command;prompt;cmd;commandline;run;"
msgstr "command;prompt;cmd;commandline;run;"

#: data/io.elementary.terminal.desktop.in:17
msgid "New Window"
msgstr "Նոր պատուհան"

#: data/io.elementary.terminal.desktop.in:22
msgid "New Root Tab"
msgstr "Նոր root ներդիր"
